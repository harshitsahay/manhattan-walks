{
  "name": "manhattan-walks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:api && npm run deploy:site",
    "deploy:api": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:site": "npm run build && wrangler pages deploy dist --project-name=manhattan-walks",
    "backup": "node scripts/backup_walks.mjs",
    "backup:restore": "node scripts/backup_walks.mjs --restore"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^4.7.1",
    "rbush": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^23.11.1",
    "vite": "^6.0.0",
    "wrangler": "^4.123.0"
  }
}
