# Cloudflare D1 + Workers (API base URL)
# Defaults to the deployed worker; override for local dev against a custom URL.
# VITE_API_BASE_URL=

# Password gate on the website.
# Leave blank and the app opens straight away.
# This is NOT real security (it ships in the browser bundle) — it only hides the
# map from a casual visitor. The real lock is the API token below.
# VITE_APP_PASSWORD=

# Token sent to the API as `X-Auth-Token`.
# Only needed after you set an API_TOKEN secret on the Worker:
#   npx wrangler secret put API_TOKEN --config worker/wrangler.jsonc
# Everyone who uses the site needs the same value, including your friend.
# VITE_API_TOKEN=